# Required: Fish Audio TTS (fish.audio) - there is no fallback voice
FISH_API_KEY=
FISH_VOICE_ID=
USER_NAME=
# Optional
JARVIS_BRAIN_MODEL=sonnet
JARVIS_SKIP_PERMISSIONS=1
# JARVIS_ALLOWED_ORIGINS=
# JARVIS_DATA_DIR=
# JARVIS_DEBUG_DOCS=1
JARVIS_FILES_DIR=            # folder JARVIS may read (default: your home folder)
JARVIS_USE_CONNECTORS=0      # 1 = let the brain use your claude.ai connectors (Gmail, Calendar...)
JARVIS_EXTRA_TOOLS=          # comma list of extra allowed tools, e.g. connector read tools
# JARVIS_ALLOWED_ORIGINS=https://your-pc.your-tailnet.ts.net   # for iPhone via Tailscale
